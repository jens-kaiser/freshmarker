PARSER_PACKAGE="ftl";
NODE_PACKAGE="ftl.ast";
DEFAULT_LEXICAL_STATE="TEMPLATE_TEXT";

INCLUDE "FTL.ccc"

INJECT PARSER_CLASS :
    import java.io.*;
    import java.util.*;
{

}

INJECT Node :
  import org.freshmarker.core.ftl.ExpressionVisitor;
  import org.freshmarker.core.ftl.FtlVisitor;
{
   default <I, O> O accept(ExpressionVisitor<I, O> visitor, I input) {
      return (O)visitor.visit(this, input);
   }

   default <I, O> O accept(FtlVisitor<I, O> visitor, I input) {
      return (O)visitor.visit(this, input);
   }
}

